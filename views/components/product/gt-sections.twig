{#
  Gentoo — product description → styled sections.

  WHY THIS EXISTS
  Salla has no per-product spec fields that can be bulk-loaded (custom fields are absent from the
  product Excel export). Descriptions ARE in the export, so this store keeps its specs, features,
  FAQ and warranty inside the description, in the fixed structure documented in
  DESCRIPTION-STANDARD.md — one <h2> followed by one <table>.

  This partial reads the description Salla already rendered, splits it on those headings, and
  rebuilds each part with the Gentoo design. Nothing is fetched, nothing is duplicated: the source
  markup is moved, not copied, and the raw block is hidden only once parsing has actually produced
  something.

  If a product's description does not follow the standard, the script bails out and the theme's
  normal description stays visible. There is no failure state where the customer sees nothing.

  INCLUDE THIS right after the .product__description block in pages/product/single.twig:
      {% include 'components.product.gt-sections' %}
#}
<div class="gt-psec" data-gt-product-sections hidden>
	<div class="gt-psec__main" data-gt-main></div>
	<aside class="gt-psec__side" data-gt-side></aside>
</div>

<script>
	(function () {
		var wrap = document.querySelector('[data-gt-product-sections]');
		if (!wrap || wrap.dataset.gtDone) return;

		var descBlock = document.querySelector('.product__description');
		var article = descBlock && descBlock.querySelector('.article--main');
		if (!article) return;

		/* ---------- Arabic-tolerant heading matching ---------- */
		function norm(s) {
			return (s || '')
				.replace(/[\u064B-\u0652\u0640\u0670]/g, '')   // diacritics + tatweel
				.replace(/[\u0623\u0625\u0622\u0671]/g, '\u0627') // alef variants
				.replace(/\u0649/g, '\u064A')                   // alef maqsura → ya
				.replace(/\u0629/g, '\u0647')                   // ta marbuta → ha
				.replace(/[:\uFF1A]\s*$/, '')                   // trailing colon
				.replace(/\s+/g, ' ')
				.trim()
				.toLowerCase();
		}

		var CANON = [
			{ kind: 'features', keys: ['المميزات الرئيسية', 'المميزات', 'مميزات المنتج', 'مميزات', 'key features', 'features'] },
			{ kind: 'specs',    keys: ['مواصفات المنتج', 'المواصفات', 'خصائص المنتج', 'الخصائص', 'المواصفات الفنية',
			                           'specifications', 'specs', 'product characteristics', 'technical specifications'] },
			{ kind: 'faq',      keys: ['الأسئلة الشائعة', 'الأسئلة المتكررة', 'frequently asked questions', 'faq'] },
			{ kind: 'warranty', keys: ['ضمان الثقة', 'الضمان', 'warranty of trust', 'warranty'] },
			{ kind: 'box',      keys: ['محتويات العلبة', 'محتويات الصندوق', 'box contents', "what's in the box"] },
			{ kind: 'offer',    keys: ['يشمل هذا العرض', 'محتويات العرض', 'what this offer includes', 'offer includes'] }
		];

		function classify(text) {
			var n = norm(text);
			for (var i = 0; i < CANON.length; i++) {
				for (var j = 0; j < CANON[i].keys.length; j++) {
					if (norm(CANON[i].keys[j]) === n) return CANON[i].kind;
				}
			}
			return 'other';
		}

		/* ---------- Row extraction ---------- */
		// A cell may hold "label: value" instead of two <td>. Split only when the label is short
		// enough to read as a label — a long sentence with a colon stays one full-width line.
		function split(t) {
			var i = t.indexOf(':');
			if (i > 0 && i <= 42) return { k: t.slice(0, i).trim(), v: t.slice(i + 1).trim() };
			return { k: '', v: t };
		}

		function rowsOf(node) {
			var out = [], i, j;
			var tag = node.tagName.toLowerCase();
			if (tag === 'table') {
				var trs = node.querySelectorAll('tr');
				for (i = 0; i < trs.length; i++) {
					var cells = [];
					for (j = 0; j < trs[i].children.length; j++) {
						if (/^(td|th)$/i.test(trs[i].children[j].tagName)) cells.push(trs[i].children[j]);
					}
					if (!cells.length) continue;
					if (cells.length >= 2) {
						var k = cells[0].textContent.trim(), v = cells[1].innerHTML.trim();
						if (k || v) out.push({ k: k, v: v, html: true });
					} else {
						var t = cells[0].textContent.trim();
						if (t) out.push(split(t));
					}
				}
			} else {
				var lis = node.querySelectorAll('li');
				for (i = 0; i < lis.length; i++) {
					var lt = lis[i].textContent.trim();
					if (lt) out.push(split(lt));
				}
			}
			return out;
		}

		/* ---------- Parse ---------- */
		var intro = [], closing = [], sections = [], seen = false, cur = null;
		var kids = Array.prototype.slice.call(article.children);

		for (var i = 0; i < kids.length; i++) {
			var el = kids[i];
			var tag = el.tagName.toLowerCase();
			var text = el.textContent.trim();

			if (/^h[1-4]$/.test(tag)) {
				if (!text) continue;
				seen = true;
				cur = { title: text, kind: classify(text), rows: [] };
				sections.push(cur);
			} else if (tag === 'table' || tag === 'ul' || tag === 'ol') {
				var rows = rowsOf(el);
				if (!rows.length) continue;
				if (cur) cur.rows = cur.rows.concat(rows);
				else sections.push({ title: '', kind: 'other', rows: rows });
			} else if (tag === 'p' && text) {
				(seen ? closing : intro).push(text);
			}
		}

		sections = sections.filter(function (s) { return s.rows.length; });

		// Nothing recognisable — leave the theme's own description alone.
		if (!sections.length) return;

		/* ---------- Build ---------- */
		var main = wrap.querySelector('[data-gt-main]');
		var side = wrap.querySelector('[data-gt-side]');

		function el(tag, cls, html) {
			var n = document.createElement(tag);
			if (cls) n.className = cls;
			if (html != null) n.innerHTML = html;
			return n;
		}
		function esc(s) {
			return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
		}
		function val(r) { return r.html ? r.v : esc(r.v); }

		function card(title, bodyEl, mod) {
			var c = el('section', 'gt-psec__card' + (mod ? ' gt-psec__card--' + mod : ''));
			if (title) c.appendChild(el('h3', 'gt-psec__title', esc(title)));
			c.appendChild(bodyEl);
			return c;
		}

		if (intro.length) {
			var lead = el('div', 'gt-psec__lead');
			intro.forEach(function (p) { lead.appendChild(el('p', null, esc(p))); });
			main.appendChild(lead);
		}

		sections.forEach(function (s) {
			var body, ul, i;

			if (s.kind === 'features') {
				// A features table often opens with a lead-in sentence rather than a real feature.
				var rows = s.rows.slice(), leadTxt = null;
				if (rows.length && !rows[0].k && /[:\uFF1A]\s*$/.test(rows[0].v)) leadTxt = rows.shift().v;
				body = el('div', 'gt-psec__features');
				if (leadTxt) body.appendChild(el('p', 'gt-psec__featlead', esc(leadTxt)));
				ul = el('ul', 'gt-psec__featlist');
				rows.forEach(function (r) {
					var li = el('li');
					li.appendChild(el('span', 'gt-psec__tick', '&#10003;'));
					var d = el('div');
					if (r.k) d.appendChild(el('strong', null, esc(r.k)));
					d.appendChild(el('span', null, val(r)));
					li.appendChild(d);
					ul.appendChild(li);
				});
				body.appendChild(ul);
				main.appendChild(card(s.title, body, 'features'));

			} else if (s.kind === 'specs') {
				body = el('dl', 'gt-psec__specs');
				s.rows.forEach(function (r) {
					if (r.k) {
						body.appendChild(el('dt', null, esc(r.k)));
						body.appendChild(el('dd', null, val(r)));
					} else {
						body.appendChild(el('dd', 'gt-psec__specs-full', val(r)));
					}
				});
				side.appendChild(card(s.title, body, 'specs'));

			} else if (s.kind === 'faq') {
				body = el('div', 'gt-psec__faq');
				s.rows.forEach(function (r, idx) {
					var d = el('details');
					if (idx === 0) d.open = true;
					d.appendChild(el('summary', null, esc(r.k || r.v)));
					d.appendChild(el('div', 'gt-psec__faq-a', val(r)));
					body.appendChild(d);
				});
				side.appendChild(card(s.title, body, 'faq'));

			} else if (s.kind === 'warranty') {
				body = el('div', 'gt-psec__warranty');
				s.rows.forEach(function (r) {
					body.appendChild(el('p', null, (r.k ? esc(r.k) + ': ' : '') + val(r)));
				});
				main.appendChild(card(s.title, body, 'warranty'));

			} else if (s.kind === 'offer' || s.kind === 'box') {
				body = el('ol', 'gt-psec__offer');
				s.rows.forEach(function (r) {
					var li = el('li');
					li.appendChild(el('span', null, (r.k ? esc(r.k) + ': ' : '') + val(r)));
					li.setAttribute('dir', 'auto');
					body.appendChild(li);
				});
				main.appendChild(card(s.title, body, 'offer'));

			} else {
				// Unknown heading → generic list titled with that heading. This is what lets
				// merchants add new sections without a code change.
				body = el('ul', 'gt-psec__generic');
				s.rows.forEach(function (r) {
					var li = el('li');
					li.setAttribute('dir', 'auto');
					li.innerHTML = (r.k ? '<strong>' + esc(r.k) + '</strong> ' : '') + val(r);
					body.appendChild(li);
				});
				main.appendChild(card(s.title, body, 'generic'));
			}
		});

		if (closing.length) {
			var foot = el('div', 'gt-psec__closing');
			closing.forEach(function (p) { foot.appendChild(el('p', null, esc(p))); });
			main.appendChild(foot);
		}

		/* ---------- Swap in ---------- */
		wrap.removeAttribute('hidden');
		descBlock.setAttribute('hidden', '');
		// The read-more control belongs to the block we just hid.
		var more = document.getElementById('btn-show-more');
		if (more) more.setAttribute('hidden', '');
		wrap.dataset.gtDone = '1';
	})();
</script>
