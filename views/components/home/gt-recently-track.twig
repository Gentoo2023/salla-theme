{#
  Recently-viewed tracker. Include on the single product page:

      {% include 'components.home.gt-recently-track' %}

  in src/views/pages/product/single.twig. Renders no markup.
#}
<script>
	(function () {
		var id = {{ product.id|json_encode }};
		if (!id) return;
		var KEY = 'gt_viewed', MAX = 12, ids = [];
		try { ids = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { ids = []; }
		if (!Array.isArray(ids)) ids = [];
		ids = ids.filter(function (x) { return String(x) !== String(id); });
		ids.unshift(id);
		try { localStorage.setItem(KEY, JSON.stringify(ids.slice(0, MAX))); } catch (e) {}
	})();
</script>
