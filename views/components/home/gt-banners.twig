{#
| Variable                    | Type     | Description        |
|-----------------------------|----------|--------------------|
| component.columns           | ?string  | "2" | "3" | "4"   |
| component.banners           | object[] |                    |
| component.banners[].image   | string   |                    |
| component.banners[].title   | ?string  |                    |
| component.banners[].url     | ?string  |                    |
#}
<section data-testid="store-home-gt-banners" class="s-block s-block--gt-banners">
	<div class="container">
		<div class="gt-grid" style="--gt-cols: {{ component.columns|default('4') }}">
			{% for banner in component.banners %}
				<a class="gt-banner {{ banner.title ? 'has-overlay' : '' }}" href="{{ banner.url|default('#') }}"
				   aria-label="{{ (banner.title ? banner.title : 'banner') | e('html_attr') }}">
					{% if banner.image %}
						<img src="{{ banner.image }}" alt="{{ banner.title }}" loading="lazy">
					{% endif %}
					{% if banner.title %}
						<span class="gt-banner__label">{{ banner.title }}</span>
					{% endif %}
				</a>
			{% endfor %}
		</div>
	</div>
</section>
