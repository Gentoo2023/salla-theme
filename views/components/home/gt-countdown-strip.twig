{#
  Section header + countdown. Place directly ABOVE a built-in products
  slider / fixed-products section in the dashboard.

| Variable              | Type    | Description                  |
|-----------------------|---------|------------------------------|
| component.title       | string  |                              |
| component.ends_at     | ?string | Y-m-d H:i                    |
| component.link_text   | ?string |                              |
| component.link_url    | ?string |                              |
#}
<section data-testid="store-home-gt-countdown" class="s-block s-block--gt-countdown">
	<div class="container">
		<div class="gt-head">
			<h2 class="gt-head__title">{{ component.title }}</h2>
			<div class="gt-head__side">
				{% if component.ends_at %}
					<salla-count-down class="gt-countdown__timer" date="{{ component.ends_at }}" boxed="true"></salla-count-down>
				{% endif %}
				{% if component.link_text and component.link_url %}
					<a class="gt-link" href="{{ component.link_url }}">{{ component.link_text }}</a>
				{% endif %}
			</div>
		</div>
	</div>
</section>
