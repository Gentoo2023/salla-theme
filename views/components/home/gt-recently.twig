{#
  Recently viewed.

  <salla-products-list> has no browsing-history source (documented enum:
  brands | categories | json | latest | offers | related | search | selected | tags)
  so the visitor's own ids are read from localStorage and passed to source="selected".

  Requires gt-recently-track.twig to be included on the single product page.
  Self-hides when there is no history.

| Variable          | Type    | Description                  |
|-------------------|---------|------------------------------|
| component.title   | string  |                              |
| component.limit   | ?string | number of products, e.g. "6" |
#}
<section data-testid="store-home-gt-recently" class="s-block s-block--gt-recently" id="gt-recently" hidden>
	<div class="container">
		<div class="gt-head">
			<h2 class="gt-head__title">{{ component.title }}</h2>
		</div>
		<salla-products-list source="selected" limit="{{ component.limit|default('6') }}"></salla-products-list>
	</div>
</section>

<script>
	(function () {
		var section = document.getElementById('gt-recently');
		if (!section) return;
		var ids = [];
		try { ids = JSON.parse(localStorage.getItem('gt_viewed') || '[]'); } catch (e) { ids = []; }
		if (!Array.isArray(ids) || !ids.length) return;

		var list = section.querySelector('salla-products-list');
		var limit = parseInt(list.getAttribute('limit'), 10) || 6;
		var shown = ids.slice(0, limit);
		if (!shown.length) return;

		list.setAttribute('source-value', JSON.stringify(shown));
		section.removeAttribute('hidden');
	})();
</script>
