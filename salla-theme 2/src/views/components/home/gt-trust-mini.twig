{#
| Variable                | Type     | Description            |
|-------------------------|----------|------------------------|
| component.items         | object[] | list of reassurances   |
| component.items[].icon  | string   | sicon-* class          |
| component.items[].text  | string   |                        |
#}
<section data-testid="store-home-gt-trust-mini" class="s-block s-block--gt-trust-mini">
	<div class="container">
		<ul class="gt-trustmini">
			{% for item in component.items %}
				<li class="gt-trustmini__item">
					<i class="{{ item.icon|default('sicon-check') }}"></i>
					<span>{{ item.text }}</span>
				</li>
			{% endfor %}
		</ul>
	</div>
</section>
